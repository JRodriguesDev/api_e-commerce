{
    "compilerOptions": {
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "strict": true,

        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",

        "rootDir": "./src",
        "outDir": "./build",

        "paths": {
            "#prisma": ["./src/services/prisma/index.ts"],
            "#fastify_plugins": ["./src/services/fastify_plugins/index.ts"],
            "#hooks_global": ["./src/hooks/global/index.ts"],
            "#interfaces": ["./src/interfaces/index.ts"],
            "#schemas/*": ["./src/validations/schemas/*"],
            "#zod*": ["./src/validations/zod/*"],
            "#utils/*": ["./src/utils/*"],
            "#middllewares": ["./src/validations/middlewares/index.ts"]
        }

    },
    "include": ["src"],
    "exclude": ["node_modules"]
}