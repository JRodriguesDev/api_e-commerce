{
    "compilerOptions": {
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "strict": true,

        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",

        "rootDir": "./src",
        "outDir": "./build",

        "paths": {
            "#prisma": ["./src/services/prisma/index.ts"],
            "#prisma_stripe/*": ["./src/services/prisma/stripe_handler/*"],
            "#fastify_plugins": ["./src/services/fastify_plugins/index.ts"],
            "#hooks_global": ["./src/hooks/global/index.ts"],
            "#interfaces": ["./src/interfaces/index.ts"],
            "#schemas/*": ["./src/validations/schemas/*"],
            "#zod*": ["./src/validations/zod/*"],
            "#utils/*": ["./src/utils/*"],
            "#middllewares": ["./src/validations/middlewares/index.ts"],
            "#stripe_core/*": ["./src/services/stripe/core/*"],
            "#stripe_checkout/*": ["./src/services/stripe/checkout/*"],
            "#stripe_hooks/*" : ["./src/services/stripe/hooks/*"],
            "#stripe_cahce/*": ["./src/services/redis/stripe_cache/*"],
            "#logic_orders/*": ["./src/logic/orders/*"]
        }

    },
    "include": ["src"],
    "exclude": ["node_modules"]
}