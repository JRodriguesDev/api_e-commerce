{
    "compilerOptions": {
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "strict": true,

        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",

        "rootDir": "./src",
        "outDir": "./build",

        "paths": {
            "#prisma": ["./src/services/prisma/index.ts"],
            "#fastify_plugins": ["./src/utils/fastify_plugins/index.ts"],
            "#hooks_global": ["./src/hooks/global/index.ts"]
        }

    },
    "include": ["src"],
    "exclude": ["node_modules", "src/services/prisma/prisma"]
}