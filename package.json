{
  "name": "api_e-commerce",
  "description": "Este projeto envolve a criação de uma API backend para uma loja online",
  "main": "build/app.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env src/app.ts",
    "build": "tsc && cpx \"src/prisma/client/*.node\" build/prisma/client",
    "start": "node ."
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "cpx": "^1.5.0",
    "npx": "^10.2.2",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.1.2",
    "redis": "^5.10.0",
    "stripe": "^20.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "imports": {
    "#fastify_plugins": [
      "./build/utils/fastify_plugins/index.js"
    ],
    "#hooks_global": [
      "./build/hooks/global/index.js"
    ],
    "#schemas/*": [
      "./build/validations/schemas/*"
    ],
    "#zod/*": [
      "./build/validations/zod/*"
    ],
    "#utils/*": [
      "./build/utils/*"
    ],
    "#middllewares/*": ["./build/validations/middlewares/*"],
    "#prisma": [
      "./build/services/prisma/index.js"
    ],
    "#prisma_stripe/*": [
      "./build/services/prisma/stripe/*"
    ],
    "#prisma_routes/*": ["./build/services/prisma/routes/*"],
    "#stripe_core/*": [
      "./build/services/stripe/core/*"
    ],
    "#stripe_checkout/*": ["./build/services/stripe/session/*"],
    "#stripe_hooks/*": [
      "./build/services/stripe/hooks/*"
    ],
    "#stripe_payments/*": ["./build/services/stripe/payments/*"],
    "#stripe_cache/*": ["./build/services/redis/stripe/*"],
    "#db_cache/*": ["./build/services/redis/db/*"],
    "#stripe_billing/*": ["./build/services/stripe/billing/*"],
    "#logic_stripe/*": ["./build/logic/stripe/*"]
  }
}
