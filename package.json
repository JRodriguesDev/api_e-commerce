{
  "name": "api_e-commerce",
  "description": "Este projeto envolve a criação de uma API backend para uma loja online",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc && cpx \"src/prisma/client/*.node\" build/prisma/client",
    "start": "node ."
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "cpx": "^1.5.0",
    "npx": "^10.2.2",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0"
  },
  "imports": {
    "#prisma": [
      "./build/services/prisma/index.js"
    ],
    "#fastify_plugins": [
      "./build/utils/fastify_plugins/index.js"
    ],
    "#hooks_global": [
      "./build/hooks/global/index.js"
    ],
    "#schemas": [
      "./build/validations/schemas/index.js"
    ]
  }
}
