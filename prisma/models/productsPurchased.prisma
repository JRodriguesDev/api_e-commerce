model ProductsPurchased {
    id String @id @default(nanoid())
    productId String
    images String[]
    name String
    description String
    quantity Int

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String
    
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("products_purchased")
}