model User {
    id String @id @default(uuid())
    name String
    email String @unique
    password String
    role UserRole[]
    cart Cart?
    products Product[]
    reviews Reviews[]
    stripeProfile StripeProfile?
    orders Order[]

    @@map("users")
}

model Role {
    id String @id @default(nanoid())
    name RoleType
    users UserRole[]

    @@map("roles")
}

model UserRole {
    user User @relation(fields: [userId], references: [id])
    userId String
    role Role @relation(fields: [roleId], references: [id])
    roleId String

    @@id([userId, roleId])
    @@map("user_roles")
}

enum RoleType {
    USER
    ADMIN
}