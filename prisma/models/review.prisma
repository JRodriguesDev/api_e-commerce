
model Reviews {
    id String @id @default(nanoid())
    rating Float
    comment String
    date DateTime @default(now())

    product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
    productId String

    author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
    authorId String

    @@map("reviews")
}