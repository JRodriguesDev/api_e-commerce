model Cart {
    id String @id @default(nanoid())
    items CartItem[]

    user User @relation(fields: [userId], references: [id])
    userId String @unique

    @@map("carts")
}

model CartItem {
    id String @id @default(nanoid())
    quantity Int @default(1)
    productId String
    title String
    description String
    images String[]
    price Float

    cart Cart @relation(fields: [cartId], references: [id])
    cartId String

    @@unique([cartId, productId])
    @@map("cart_items")
}