model Product {
    id String @default(nanoid()) @id 
    title String
    description String
    category String
    price Float
    rating Float
    stock Int
    images String[]
    thumbnail String
    reviews Reviews[]

    owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    ownerId String

    createdAt DateTime @default(now())

    @@map("products")
}