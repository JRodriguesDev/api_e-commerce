model Product {
    id String @default(nanoid()) @id 
    title String
    description String
    category String
    price Float
    rating Float
    stock Int
    images String[]
    thumbnail String
    reviews Reviews[]
    @@map("products")
}

model Category {
    id Int @id @default(autoincrement())
    name String

    @@map("categories")
}

model Reviews {
    id String @id @default(nanoid())
    rating Float
    comment String
    date DateTime @default(now())

    product Product @relation(fields: [productId], references: [id])
    productId String

    author User @relation(fields: [authorId], references: [id])
    authorId String

    @@map("reviews")
}